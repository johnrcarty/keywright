# The minimal broker does not require this file. Copy to .env for local overrides.
KEYWRIGHT_IMAGE=ghcr.io/johnrcarty/keywright:0.0.2-preview
KW_HTTP_PORT=8700
KW_BIND_ADDRESS=127.0.0.1
KW_PUBLIC_URL=http://localhost:8700
KW_TRUSTED_PROXIES=
# Optional LLM overlay. Generate each secret separately before enabling it.
PG_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# Optional knowledge index overlay.
KNOWLEDGE_PG_PASSWORD=
