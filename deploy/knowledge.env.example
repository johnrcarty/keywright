# Optional disposable search index; Keywright's primary DB remains unchanged.
KW_KNOWLEDGE_PG_URL=postgresql://knowledge:CHANGE_ME@knowledge-postgres:5432/knowledge
# LiteLLM API base, ending in /v1. Use a dedicated embedding-only virtual key with a budget.
KW_KNOWLEDGE_EMBEDDING_URL=http://litellm:4000/v1
KW_KNOWLEDGE_EMBEDDING_KEY=CHANGE_ME
KW_KNOWLEDGE_EMBEDDING_MODEL=knowledge-embedding
# Optional local, read-only Git checkout. Only committed .md files are imported.
KW_KNOWLEDGE_GIT_ROOT=/knowledge-source
