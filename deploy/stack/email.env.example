# email-mcp (mcp-email-server) account for the agents' mailbox. Copied to
# a protected email.env file (0600) on the broker host; fill that local file, never this example.
# No quotes: compose passes values verbatim.
MCP_EMAIL_SERVER_ACCOUNT_NAME=agents
MCP_EMAIL_SERVER_FULL_NAME=Agents
MCP_EMAIL_SERVER_EMAIL_ADDRESS=agents@example.com
MCP_EMAIL_SERVER_IMAP_HOST=imap.example.com
MCP_EMAIL_SERVER_SMTP_HOST=smtp.example.com
MCP_EMAIL_SERVER_PASSWORD=
# The floor under Keywright's per-agent rules: nothing is sent, forwarded or drafted to an address
# outside this list, whoever approved it. Comma-separated globs on the bare address; empty = no sending.
MCP_EMAIL_SERVER_ALLOWED_RECIPIENTS=*@example.com
# Enable only when using Mail's PDF delivery/download. This returns attachment bytes over MCP;
# it does not enable filesystem downloads. Also grant get_attachment_content to the mail agent.
MCP_EMAIL_SERVER_ENABLE_ATTACHMENT_CONTENT=false
